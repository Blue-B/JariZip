{
  "name": "jarizip",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first career workspace for Korean job seekers",
  "author": "JariZip contributors",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "node server/index.mjs",
    "start": "node server/index.mjs",
    "local": "node scripts/local.mjs",
    "local:check": "node scripts/local.mjs --check --no-browser",
    "preview:start": "node scripts/preview.mjs start",
    "preview:stop": "node scripts/preview.mjs stop",
    "desktop": "npm run build && electron desktop/main.mjs",
    "desktop:smoke": "npm run build && node desktop/smoke.mjs",
    "desktop:icons": "node desktop/build/make-icons.mjs",
    "package:linux": "npm run build && electron-builder --linux dir AppImage",
    "package:win": "npm run build && electron-builder --win portable",
    "package:win:installer": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test server/*.test.mjs scripts/*.test.mjs desktop/*.test.mjs",
    "test:desktop": "node desktop/smoke.mjs",
    "test:live": "node scripts/check-live-jobs.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.48.0",
    "mammoth": "1.12.3",
    "motion": "13.4.4",
    "pdfjs-dist": "6.3.289",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
