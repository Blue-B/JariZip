# 자리집 로컬 서버 환경 설정 예시
# 이 파일을 `.env.local`로 복사한 뒤, 본인이 발급·승인받은 값을 직접 채워 넣으세요.
# 실제 키를 이 예시 파일이나 Git에 올리지 마세요. `.env.local`은 .gitignore에 포함되어 있습니다.

# 사람인 공식 채용정보 API (이용신청 승인 후 앱별 access-key 발급, 1일 최대 500회)
# 공식 안내: https://oapi.saramin.co.kr/guide/info
SARAMIN_ACCESS_KEY=

# 조블(Jooble) 공식 검색 API 키
# 조블은 여러 채용 사이트의 공고를 모아 제공하는 검색 API입니다. 서버에서만 보관하고 화면·로그·URL로 되돌려주지 않습니다.
# 공식 안내: https://kr.jooble.org/api/about
JOOBLE_API_KEY=

# 고용24(한국고용정보원) 공식 채용정보 Open API 인증키
# 고용24 기업회원 로그인 후 서비스별 신청 · 담당자 심사 · 인증키 발급이 필요하며, 인증키는 양도할 수 없습니다.
# 공식 안내: https://www.work24.go.kr/cm/e/a/0110/selectOpenApiIntro.do
WORK24_AUTH_KEY=

# 원티드 OpenAPI 인증 정보 (두 값이 모두 있어야 동작)
# 원티드랩 OpenAPI 인증 신청 후 client-id와 client-secret을 메일로 발급받습니다.
# 공식 안내: https://openapi.wanted.jobs/apply/
WANTED_CLIENT_ID=
WANTED_CLIENT_SECRET=

# 잡알리오(재정경제부 공공기관 채용정보) 공공데이터포털 일반 인증키
# 공공데이터포털에서 공공기관 채용정보 조회서비스를 활용신청한 뒤 일반 인증키를 발급받습니다.
# 목록 조회만 제공하며 상세 내용과 첨부파일은 원문에서 확인합니다.
# 공식 안내: https://www.data.go.kr/data/15125273/openapi.do
JOBALIO_SERVICE_KEY=

# 허용할 추가 호스트가 있을 때만 설정합니다. 기본은 localhost/127.0.0.1/[::1]입니다.
# JARIZIP_ALLOWED_HOSTS=
